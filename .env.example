# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://YOUR_PROJECT_ID_HERE.run.app"

# Supabase Authentication & Database Configuration (Auto-connected)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID_HERE.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_API_KEY_HERE"
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID_HERE.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_API_KEY_HERE"

# OneSignal Push Notification Configuration
VITE_ONESIGNAL_APP_ID="YOUR_API_KEY_HERE"

# ZEGOCLOUD / ZagCloud Configuration
VITE_ZEGOCLOUD_APP_ID="YOUR_PROJECT_ID_HERE"
VITE_ZEGOCLOUD_APP_SIGN="YOUR_API_KEY_HERE"

# Firebase Configuration
VITE_FIREBASE_API_KEY="YOUR_API_KEY_HERE"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID_HERE"
