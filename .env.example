# =====================================================================
# 🚀 PULSE SOCIAL VIDEO & LIVE STREAMING PLATFORM - ENVIRONMENT CONFIG
# =====================================================================
# Rename this file to '.env' and fill in your keys.
# See 'Documentation/API_KEYS_SETUP_GUIDE.md' for step-by-step instructions.
# =====================================================================

# 1. 🗄️ SUPABASE CONFIGURATION (Required for live multi-user database & auth)
# Get these free from: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID_HERE.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID_HERE.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"

# 2. 🤖 GOOGLE GEMINI AI (Optional - Powers AI viral reel ideas & caption generator)
# Get your free key from: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYOUR_GEMINI_KEY_HERE"

# 3. 📹 ZEGOCLOUD (Optional - For HD WebRTC 1-on-1 audio/video calling & live rooms)
# Get these free from: https://www.zegocloud.com/ -> Admin Console
VITE_ZEGOCLOUD_APP_ID="YOUR_ZEGOCLOUD_APP_ID"
VITE_ZEGOCLOUD_APP_SIGN="YOUR_ZEGOCLOUD_64_CHAR_APP_SIGN"

# 4. 🔔 ONESIGNAL PUSH NOTIFICATIONS (Optional - Web & Mobile Push Alerts)
# Get from: https://onesignal.com -> Settings -> Keys & IDs
VITE_ONESIGNAL_APP_ID="YOUR_ONESIGNAL_APP_ID"

# 5. 🔥 FIREBASE BACKEND (Optional alternative)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# 6. 🌐 PRODUCTION APP URL (Optional - Domain where the app is deployed)
APP_URL="https://your-domain.vercel.app"
